# 复制成 .env 后填自己的值，别提交、别发给别人
# 任何 OpenAI 兼容的接口都行：OpenAI / DeepSeek / 通义 / 自建网关……

# --- 大模型（必填，不然聊天会提示缺 key）---
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# 工具轮数上限（默认 3，和上一版手写循环一致；改大要小心 token 和耗时）
MAX_TOOL_ROUNDS=3

# --- 上下文管理（多轮对话 + 摘要 + 预算）---
# CONTEXT_MAX_TURNS：每次发给模型时最多带最近几轮对话（1 轮 = 1 问 + 1 答）
CONTEXT_MAX_TURNS=10
# CONTEXT_MAX_CHARS：摘要 + 长期事实 + 最近对话的字符预算上限（约 4 字符 ≈ 1 token，
# 12000 字符 ≈ 3000 token）；超了先从最旧一轮开始截，永远保留最后一轮和系统提示
CONTEXT_MAX_CHARS=12000
# SUMMARY_THRESHOLD_TURNS：chat_log 里轮数超过这个数时，recall 时把最旧的、
# 超出最近 CONTEXT_MAX_TURNS 的那些轮用模型总结进 summaries 表（没 key 或总结
# 失败时直接截断删掉，不报错）；默认 20 轮
SUMMARY_THRESHOLD_TURNS=20

# --- 网关演示登录（仅原型用，生产请换 Keycloak / Authentik）---
# 格式：用户名:密码,用户名:密码 ；租户 id 就是用户名（只允许字母数字 _ -）
# 首次使用务必改掉默认密码！
GATEWAY_SECRET=change-me-to-a-long-random-string
GATEWAY_USERS=demo:demo123,tenant-a:changeme-a

# --- 沙箱 ---
# docker = 每会话起一个容器（需要宿主机有 Docker + 挂载 docker.sock）
# local  = 没有 Docker 时的开发回退，在 agent 本地跑白名单命令（未隔离！）
SANDBOX_MODE=docker
SANDBOX_IMAGE=python:3.12-slim

# --- 浏览器服务（容器内网地址，本地调试可改成 http://127.0.0.1:8001）---
BROWSER_URL=http://browser:8001

# --- 可选：postgres / redis（当前版本 agent 默认不用，留给以后）---
POSTGRES_USER=mt_agent
POSTGRES_PASSWORD=changeme-postgres
POSTGRES_DB=mt_agent
